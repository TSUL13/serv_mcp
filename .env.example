# Configuración de acceso a Cisco SD-WAN vManage
# Copia este archivo a .env y completa con tus credenciales

# IP o hostname del vManage (sin https://)
VMANAGE_IP=192.168.1.1

# Credenciales de autenticación
VMANAGE_USERNAME=admin
VMANAGE_PASSWORD=your_password_here

# Credenciales SSH para conexión directa a dispositivos SD-WAN
# (Opcional: Si no se especifica, se usarán las credenciales de vManage)
SDWAN_SSH_USER=admin
SDWAN_SSH_PASSWORD=your_ssh_password_here
